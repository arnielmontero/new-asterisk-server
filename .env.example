# Copy to .env and fill in every value, or run ./scripts/init-env.sh to generate
# a .env with random secrets. .env is git-ignored and must never be committed.
#
# Password / secret rules: Asterisk config files treat ; # and $ specially, so
# SIP and AMI passwords must match [A-Za-z0-9._~+=-]{16,}. Hex strings from
# `openssl rand -hex 16` always satisfy this.

# --- PostgreSQL (§17) ---
POSTGRES_DB=comms
POSTGRES_USER=comms
POSTGRES_PASSWORD=

# --- Backend ---
# At least 32 characters. `openssl rand -hex 32`
JWT_SECRET=
# Used once to seed the initial "admin" user. Not overwritten on restart.
ADMIN_PASSWORD=

# --- Asterisk AMI (§25-26) ---
AMI_USER=backend
AMI_PASS=
AMI_PORT=5038
# Source networks allowed to log in to AMI besides 127.0.0.1 (CIDR).
# Must cover the Docker bridge the backend container connects from.
AMI_PERMIT=172.16.0.0/12

# --- Network identity (§14-16) ---
# Where the frontend/backend containers reach Asterisk (host networking).
# host.docker.internal is mapped to the Docker host via extra_hosts: host-gateway.
# Alternatively set the server's LAN IP.
ASTERISK_HOST=host.docker.internal
# LAN IP and DNS name of this server. Both become certificate SANs.
SERVER_IP=192.168.1.100
SERVER_HOSTNAME=communications.local
# Trusted LAN subnet allowed to register physical SIP phones (CIDR).
LAN_SUBNET=192.168.0.0/16
# Source networks of the Nginx proxy as seen by Asterisk for WebRTC (CIDR).
PROXY_PERMIT=172.16.0.0/12

# --- RTP (§44) ---
RTP_START=10000
RTP_END=10200

# --- SIP extension credentials (§3) ---
# Browser (WebRTC) clients
EXT_1001_PASSWORD=
EXT_1002_PASSWORD=
# Physical SIP phones register as 1001-phone / 1002-phone (see DEPLOYMENT.md)
EXT_1001_PHONE_PASSWORD=
EXT_1002_PHONE_PASSWORD=
